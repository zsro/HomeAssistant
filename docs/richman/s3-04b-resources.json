      "exeOffset": 408819
    },
    {
      "characterId": "chyan",
      "nativeCharacter": 3,
      "slot": 1,
      "label": "ref_00467259",
      "resource": 1132,
      "text": "我是幸運女神！",
      "rawHex": "2331313332a7daac4fa9afb942a46bafaba149",
      "exeOffset": 408842
    },
    {
      "characterId": "chyan",
      "nativeCharacter": 3,
      "slot": 2,
      "label": "ref_0046726d",
      "resource": 1133,
      "text": "不賴嘛∼",
      "rawHex": "2331313333a4a3bfe0b9c0a1e3",
      "exeOffset": 408862
    },
    {
      "characterId": "chyan",
      "nativeCharacter": 3,
      "slot": 15,
      "label": "ref_00467333",
      "resource": 1146,
      "text": "算你便宜一點，\n快來吧！",
      "rawHex": "2331313436bae2a741ab4ba979a440c249a1410aa7d6a8d3a761a149",
      "exeOffset": 409060
    },
    {
      "characterId": "salonbus",
      "nativeCharacter": 1,
      "slot": 0,
      "label": "ref_00466dcd",
      "resource": 1077,
      "text": "阿拉真主！\n我讚美你！",
      "rawHex": "2331303737aafca9d4af75a544a1490aa7dac667acfca741a149",
      "exeOffset": 407678
    },
    {
      "characterId": "salonbus",
