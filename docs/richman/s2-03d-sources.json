  "newEvents": [
    {
      "id": 6,
      "handler": "fcn_004494e0",
      "targets": "uniform all ordinary then facilities, ownership/level unrestricted; ordinary strcmp(name) all same-name lands, facility single target",
      "writes": "ordinary word+1c / facility word+22 = truncate(value*1.3) narrowed to16 bits; no writes to upgrade/rent/owner/type fields",
      "downstream": "purchase/goudi valuation; auction floor(base*(1+level*.5)); news12 sum(base+level*cost); facility initial build base; rent tables remain separate"
    },
    {
      "id": 7,
      "handler": "fcn_00449735",
      "targets": "all unowned ordinary then facilities; any building allowed; uniform one",
      "entry": "_rich4_ui_auction_entry(-1,target,1)",
      "reserve": "_rich4_ui_auction_entry at43bde5: floor(base*(1+level*.5))*priceIndex",
      "eligibility": "who_plays!=0; cash>reserve; hotel/stop/hospital/prison/winter/dream bytes+50..55 all zero; caller exclusion==-1 excludes none",
      "payment": "loc_0043c83b fcn_0041d2c6(winner,-1,bid,0); winner cash constrained by auction; receipt public fund ref00499080",
      "noBid": "winner==-1 skips ownership and payment; property stays unowned",
      "WebDifference": "reuse ascending hotseat increments, not original realtime UI; no ownership expiration calendar"
    },
    {
      "id": 12,
      "handler": "fcn_00449de6",
      "assessment": "all active players, no detention exemption; sum each owned ordinary(word1c+byte1a*word1e) and facility(word22+byte1a*word24); floor(total*.05)*priceIndex; freeze first, then settle in player order",
      "payment": "fcn_0041d2c6(player,-1,due,0): cash then bank; if shortage cap actual paid and invoke bankrupt; actual receipt public fund; no stock rescue before bankruptcy",
      "bankruptcy": "rich4_player_bankrupt marks who_plays0 first, clears stats/assets, later sells shares/tools/cards and may auction3 random former properties if more than3; not an opportunity to rescue tax",
      "WebDifference": "reuse existing candidate release land but retain buildings and item pools; tax returns shares to pool without proceeds; full original forced auctions/asset sales deferred; stop at single survivor and confirm news before end screen"
    }
  ],
