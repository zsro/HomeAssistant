  "strategyFacts": {
    "worker": "owned legal ordinary land only; rank positive raw rent increment then lexical id; free existing command",
    "remote": "walking single die; at most six edges; score affordable land 40/30/10 after 1000 cash reserve; points20/unknown0/opponent-100/hazard-path-1000; best>=30 and spread>=10; ties smallest dice/node",
    "cashQuote": "raw dynamic base + level * build cost, then index exactly once; upgrade cost * index; heuristic only",
    "acquisition": "one initial remote/worker from existing v44; refill one remote at existing shop price30 points, shelf and pool; no worker sale or synthetic production",
    "decisionSafety": "recompute confirmation; invalid target cancels without consume; impossible mid-selection mobility conflicts stop rather than dispatch illegal action",
    "random": "policy does not access randomState/seed/hidden news/fortune/G7 snapshots; no engine simulation or random draw",
    "replay": "control policy is host metadata; actual commands drive replay; engine/world snapshots unchanged"
