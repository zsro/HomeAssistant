PORT=3001
NODE_ENV=development

DB_HOST=106.15.230.148
DB_PORT=3306
DB_NAME=homeAssistantDB
DB_USER=homeAssistantUser
DB_PASSWORD=change-me

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=home-assistant
JWT_AUDIENCE=home-assistant-clients
CORS_ORIGINS=https://meiji3d.com,https://www.meiji3d.com
LOG_LEVEL=info

# Required only for the one-time migration that discards legacy tables.
ALLOW_LEGACY_RESET=0

# Development/test bootstrap input only. In production, use
# scripts/bootstrap-production-user.sh so the password is read without echo.
BOOTSTRAP_USERNAME=owner
BOOTSTRAP_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_DISPLAY_NAME=Owner
